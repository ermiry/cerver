PROJECT_NAME           = cerver
PROJECT_BRIEF          = "C library to build fast and reliable servers"
OUTPUT_DIRECTORY       = reference
STRIP_FROM_PATH        = include
STRIP_FROM_INC_PATH    = include
FULL_PATH_NAMES        = YES
JAVADOC_AUTOBRIEF      = NO
OPTIMIZE_OUTPUT_FOR_C  = YES
TYPEDEF_HIDES_STRUCT   = NO
MARKDOWN_SUPPORT       = YES
ALIASES                = "threadsafety=@par Thread safety^^"
EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES
EXTRACT_PRIVATE        = NO
INTERNAL_DOCS          = NO
CASE_SENSE_NAMES       = YES
SORT_MEMBER_DOCS       = NO
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_FORMAT            = "$file:$line: $text"
INPUT                  = include/cerver
FILE_PATTERNS          = *.h
RECURSIVE              = YES
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = include
PREDEFINED             = "CERVER_EXPORT=extern" \
                         "CERVER_PRIVATE=extern" \
                         "CERVER_PUBLIC=extern" \
                         "CERVER_HIDDEN=extern" \
                         "CERVER_INLINE=inline" \
                         "CERVER_PRINTF_FORMAT(a,b)=" \
                         "CERVER_ATTRS(x)=" \
                         "DEPRECATED(func)=func"
SKIP_FUNCTION_MACROS   = YES
EXCLUDE_SYMBOLS        = XX
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
HAVE_DOT               = NO
