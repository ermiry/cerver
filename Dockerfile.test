FROM gcc:13.4

ARG SANITIZER=''

RUN apt-get update && apt-get install -y libssl-dev libcurl4-openssl-dev gdb && apt-get clean

WORKDIR /opt/cerver

COPY . .
RUN make TYPE=test SANITIZER=${SANITIZER} -j4 && make TYPE=test SANITIZER=${SANITIZER} -j4 test
RUN if [ -z "${SANITIZER}" ]; then make TYPE=test load; fi

ENV LD_LIBRARY_PATH=/opt/cerver/bin:/opt/cerver/test/bin/app

CMD ["bash", "test/pair.sh", "web/web"]
